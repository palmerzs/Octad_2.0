# 6. SETUP PARALLEL CLUSTER
# -------------------------
num_cores <- 15
cl <- makeCluster(num_cores)
registerDoParallel(cl)

cat(paste("Cluster active with", num_cores, "cores. Processing", length(drug_files), "drug files.\n"))

# 7. RUN PARALLEL LOOP (FIXED & ROBUST)
# --------------------
start_time <- Sys.time()

new_results_df <- foreach(
  drug_file_path = drug_files, 
  .combine = bind_rows,
  .packages = c("tidyverse", "stringr"), 
  .export = c("cmap_score_new", "disease_meta", "disease_sig_dir", "log_dir", 
              "manual_mapping", "meta", "completed_pairs") 
) %dopar% {
  
  # --- WORKER CODE ---
  
  # A. Identify File and Metadata Tissue
  drug_file_name <- basename(drug_file_path)
  current_key <- str_remove(drug_file_name, "_DESeq2_results.csv")
  
  log_file <- file.path(log_dir, paste0("Log_", current_key, ".txt"))
  writeLines(paste("Started processing:", current_key, "at", Sys.time()), log_file)
  
  # B. Lookup Tissue in Metadata
  meta_row <- meta %>% filter(Key == current_key)
  
  if(nrow(meta_row) == 0) {
    cat(paste("\nERROR: Key not found in Metadata:", current_key), file = log_file, append = TRUE)
    return(NULL)
  }
  
  # Handle capitalization for 'Tissue'
  if("Tissue" %in% names(meta_row)) {
    my_tissue <- meta_row$Tissue[1]
  } else if("tissue" %in% names(meta_row)) {
    my_tissue <- meta_row$tissue[1]
  } else {
    cat("\nERROR: Metadata missing 'Tissue' column.", file = log_file, append = TRUE)
    return(NULL)
  }
  
  # C. Map to Disease Keywords
  # Fix: Use base unique() instead of dplyr::unique() for vectors
  mapped_keywords <- manual_mapping %>% 
    filter(Meta_Tissue_Name == my_tissue) %>%
    pull(Target_Disease_Keyword) %>%
    unique()
  
  if(length(mapped_keywords) == 0) {
    cat(paste("\nWARNING: No mapping found for tissue:", my_tissue), file = log_file, append = TRUE)
    return(NULL)
  }
  
  # D. Filter Disease Database
  pattern_string <- paste(mapped_keywords, collapse = "|")
  matching_disease_files <- disease_meta %>% 
    filter(str_detect(OrganRegion, regex(pattern_string, ignore_case = TRUE)))
  
  if (nrow(matching_disease_files) == 0) {
    cat(paste("\nNo disease signatures found matching:", pattern_string), file = log_file, append = TRUE)
    return(NULL)
  }
  
  # E. Prepare Drug Signature
  drug_data <- read_csv(drug_file_path, show_col_types = FALSE)
  
  drug_sig <- drug_data %>%
    filter(!is.na(Human_Ensembl)) %>%
    group_by(Human_Ensembl) %>%
    summarize(Value = median(log2FoldChange, na.rm = TRUE)) %>%
    ungroup()
  
  cmap_exp_signature <- data.frame(
    ids = drug_sig$Human_Ensembl,
    rank = -1 * rank(drug_sig$Value) 
  )
  drug_gene_universe <- cmap_exp_signature$ids
  
  worker_results_list <- list()
  
  # F. Run Comparisons
  for (i in 1:nrow(matching_disease_files)) {
    
    disease_row <- matching_disease_files[i,]
    
    # --- ROBUST COLUMN EXTRACTION (Fixes 'length zero' error) ---
    # Attempts to find Disease/File columns regardless of capitalization
    
    # 1. Get Disease Name
    disease_name <- NULL
    if ("Disease" %in% names(disease_row)) disease_name <- disease_row$Disease
    else if ("disease" %in% names(disease_row)) disease_name <- disease_row$disease
    
    # 2. Get File Name
    disease_file_name <- NULL
    if ("File" %in% names(disease_row)) disease_file_name <- disease_row$File
    else if ("file" %in% names(disease_row)) disease_file_name <- disease_row$file
    
    # 3. Safety Check
    if (length(disease_name) == 0 || is.na(disease_name) || length(disease_file_name) == 0 || is.na(disease_file_name)) {
      cat(paste("\nWARNING: Missing Disease or File column for row", i), file = log_file, append = TRUE)
      next
    }
    # ------------------------------------------------------------
    
    disease_organ <- disease_row$OrganRegion
    
    # Check if pair is done
    pair_id <- paste(drug_file_name, disease_file_name, sep = "|")
    if (pair_id %in% completed_pairs) next 
    
    if (i %% 10 == 0) cat(paste0("\n[", i, "/", nrow(matching_disease_files), "] Comparing: ", disease_name), file = log_file, append = TRUE)
    
    # Find Disease File
    disease_file_path <- file.path(disease_sig_dir, disease_name, disease_file_name)
    
    # Check if file exists (Safe now because path is guaranteed to be a string)
    if (!file.exists(disease_file_path)) {
      cat(paste("\nSkipping missing file:", disease_file_path), file = log_file, append = TRUE)
      next
    }
    
    # Read & Filter Disease Genes
    dz <- read_csv(disease_file_path, show_col_types = FALSE)
    dz <- dz %>% filter(identifier %in% drug_gene_universe)
    
    dz_up <- dz %>% filter(log2FoldChange > 1 & padj < 0.05)
    dz_down <- dz %>% filter(log2FoldChange < -1 & padj < 0.05)
    
    dz_up_genes <- head(dz_up$identifier, min(nrow(dz_up), 500))
    dz_down_genes <- head(dz_down$identifier, min(nrow(dz_down), 500))
    
    up_len <- length(dz_up_genes); down_len <- length(dz_down_genes)
    if (up_len < 10 | down_len < 10) next
    
    # Calc Scores
    raw_score <- cmap_score_new(dz_up_genes, dz_down_genes, cmap_exp_signature, gamma = 1)
    
    z_all <- numeric(5)
    for (rand_seed in 1:5) {
      set.seed(rand_seed)
      score_rd <- numeric(300)
      for (j in 1:300) {
        score_rd[j] <- cmap_score_new(sample(drug_gene_universe, up_len), sample(drug_gene_universe, down_len), cmap_exp_signature, gamma = 1)
      }
      null_mean <- mean(score_rd, na.rm = TRUE)
      null_sd <- sd(score_rd, na.rm = TRUE)
      
      # Safety for SD calculation
      if (!is.na(null_sd) && null_sd != 0) {
        z_all[rand_seed] <- (raw_score - null_mean) / null_sd
      } else {
        z_all[rand_seed] <- NA
      }
    }
    z_score_median <- median(z_all, na.rm = TRUE)
    
    worker_results_list[[length(worker_results_list) + 1]] <- data.frame(
      Drug_Signature = drug_file_name,
      Drug_Tissue = my_tissue,
      Disease_Signature = disease_file_name,
      Disease_Name = disease_name,
      Disease_Tissue = disease_organ,
      Raw_Score = raw_score,
      Z_Score_Median = z_score_median,
      Up_Genes_Used = up_len,
      Down_Genes_Used = down_len
    )
  }
  
  cat(paste0("\nFINISHED at ", Sys.time()), file = log_file, append = TRUE)
  bind_rows(worker_results_list)
}

# 8. CLEAN UP AND MERGE
# ---------------------
stopCluster(cl)
