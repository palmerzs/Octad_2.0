# --- 8. PROXIMITY FUNCTION --------------------------------------------------

compute_proximity_fast <- function(graph, set_a, set_b) {
  nodes <- igraph::V(graph)$name
  set_a <- intersect(set_a, nodes)
  set_b <- intersect(set_b, nodes)
  if (length(set_a) == 0 || length(set_b) == 0) return(NA_real_)
  dist_mat <- igraph::distances(graph, v = set_a, to = set_b)
  d_ab <- mean(apply(dist_mat, 1, function(x) {
    v <- x[is.finite(x)]; if (length(v) == 0) NA else min(v)
  }), na.rm = TRUE)
  d_ba <- mean(apply(dist_mat, 2, function(x) {
    v <- x[is.finite(x)]; if (length(v) == 0) NA else min(v)
  }), na.rm = TRUE)
  (d_ab + d_ba) / 2
}

