# --- 4. HELPER FUNCTIONS ----------------------------------------------------

get_disease_folder <- function(filename) sub("_.*", "", filename)

# Return all significant DE genes sorted by |log2FC| descending
# Drug side: uses log2FoldChange and padj, returns Human_Ensembl
get_drug_de_genes <- function(sig) {
  sig <- sig[!is.na(sig$padj) &
             !is.na(sig$log2FoldChange) &
             !is.na(sig$Human_Ensembl), ]
  sig <- sig[sig$padj < 0.05, ]
  if (nrow(sig) == 0) return(character(0))
  sig <- sig[order(abs(sig$log2FoldChange), decreasing = TRUE), ]
  sig$Human_Ensembl
}

# Disease side: uses log2FoldChange and padj, returns identifier (ENSG)
get_disease_de_genes <- function(sig) {
  sig <- sig[!is.na(sig$padj) &
             !is.na(sig$log2FoldChange) &
             !is.na(sig$identifier), ]
  sig <- sig[sig$padj < 0.05, ]
  if (nrow(sig) == 0) return(character(0))
  sig <- sig[order(abs(sig$log2FoldChange), decreasing = TRUE), ]
  sig$identifier
}

extract_de_ensg_ids <- function(sig_name, type) {
  if (type == "drug") {
    df   <- read_csv(file.path(drug_base, sig_name), show_col_types = FALSE)
    ensg <- get_drug_de_genes(df)
  } else {
    path <- file.path(disease_base, get_disease_folder(sig_name), sig_name)
    df   <- read_csv(path, show_col_types = FALSE)
    ensg <- get_disease_de_genes(df)
  }
  unique(ensg)
}


# --- 5. ENSG TO STRING MAP --------------------------------------------------
# Built from DE genes only — safe to rerun, loads from cache if available

map_path <- file.path(prox_dir, "ensg_to_string_map_DE.rds")

if (file.exists(map_path)) {
  cat("Loading ENSG to STRING map from cache...\n")
  ensg_to_string_map <- readRDS(map_path)
} else {
  cat("Collecting all unique DE ENSG IDs...\n")
  unique_drug_sigs    <- unique(reversal$Drug_Signature)
  unique_disease_sigs <- unique(reversal$Disease_Signature)

  all_drug_ensg    <- unique(unlist(lapply(unique_drug_sigs,
                                           extract_de_ensg_ids, type = "drug")))
  all_disease_ensg <- unique(unlist(lapply(unique_disease_sigs,
                                           extract_de_ensg_ids, type = "disease")))
  all_ensg         <- unique(c(all_drug_ensg, all_disease_ensg))
  cat("Total unique DE ENSG IDs:", length(all_ensg), "\n")

  cat("Batch mapping ENSG to Symbol...\n")
  symbol_map    <- mapIds(org.Hs.eg.db,
                          keys      = all_ensg,
                          column    = "SYMBOL",
                          keytype   = "ENSEMBL",
                          multiVals = "first")
  valid_symbols <- symbol_map[!is.na(symbol_map)]
  sym_df        <- data.frame(
    symbol           = as.character(valid_symbols),
    ensg             = names(valid_symbols),
    stringsAsFactors = FALSE
  )

  cat("Batch mapping Symbol to STRING ID...\n")
  string_db <- STRINGdb$new(
    version         = "12.0",
    species         = 9606,
    score_threshold = 400,
    input_directory = string_cache
  )
  sym_mapped         <- string_db$map(sym_df, "symbol", removeUnmappedRows = TRUE)
  ensg_to_string_map <- setNames(sym_mapped$STRING_id, sym_mapped$ensg)

  saveRDS(ensg_to_string_map, map_path)
  cat("Map saved:", length(ensg_to_string_map), "mappings\n")
}

