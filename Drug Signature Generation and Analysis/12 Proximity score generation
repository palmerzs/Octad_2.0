lookup_string_ids <- function(ensg_ids) {
  ids <- ensg_to_string_map[ensg_ids]
  unique(ids[!is.na(ids)])
}

# Each signature returns list(N5, N10, N20) of STRING IDs
# Returns empty character(0) for each if no significant DE genes
build_de_gene_set <- function(sig_name, type) {
  if (type == "drug") {
    df   <- read_csv(file.path(drug_base, sig_name), show_col_types = FALSE)
    ensg <- get_drug_de_genes(df)
  } else {
    path <- file.path(disease_base, get_disease_folder(sig_name), sig_name)
    df   <- read_csv(path, show_col_types = FALSE)
    ensg <- get_disease_de_genes(df)
  }

  if (length(ensg) == 0) {
    return(list(N5  = character(0),
                N10 = character(0),
                N20 = character(0)))
  }

  string_ids <- lookup_string_ids(ensg)

  list(
    N5  = head(string_ids, 5),
    N10 = head(string_ids, 10),
    N20 = head(string_ids, 20)
  )
}

