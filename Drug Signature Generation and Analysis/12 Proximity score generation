reversal_output_path <- file.path(prox_dir, "Semaglutide_Proximity_DE_Results.csv")
checkpoint_path      <- file.path(prox_dir, "proximity_DE_checkpoint.rds")
temp_csv_path        <- paste0(reversal_output_path, ".tmp")

if (file.exists(checkpoint_path)) {
  completed <- readRDS(checkpoint_path)
  cat("Resuming from checkpoint:", nrow(completed), "pairs done\n")
} else {
  completed <- NULL
  cat("Starting fresh\n")
}

done_idx      <- if (!is.null(completed)) completed$row_idx else integer(0)
remaining_idx <- setdiff(1:nrow(reversal), done_idx)
cat("Pairs remaining:", length(remaining_idx), "\n")

chunk_size <- 500
chunks     <- split(remaining_idx,
                    ceiling(seq_along(remaining_idx) / chunk_size))

n_cores <- max(1, detectCores() - 4)
cat("Running on", n_cores, "cores\n")

tic()
for (chunk_i in seq_along(chunks)) {
  idx <- chunks[[chunk_i]]

  # Fresh cluster each chunk to prevent memory accumulation
  cl <- makeCluster(n_cores)
  registerDoParallel(cl)
  clusterExport(cl, varlist = c(
    "string_graph", "drug_gene_sets", "disease_gene_sets",
    "compute_proximity_fast", "reversal"
  ))
  clusterEvalQ(cl, library(igraph))

  chunk_results <- foreach(
    i         = idx,
    .combine  = rbind,
    .packages = "igraph"
  ) %dopar% {
    tryCatch({
      row <- reversal[i, ]

      drug_N5  <- drug_gene_sets[[row$Drug_Signature]]$N5
      drug_N10 <- drug_gene_sets[[row$Drug_Signature]]$N10
      drug_N20 <- drug_gene_sets[[row$Drug_Signature]]$N20
      dis_N5   <- disease_gene_sets[[row$Disease_Signature]]$N5
      dis_N10  <- disease_gene_sets[[row$Disease_Signature]]$N10
      dis_N20  <- disease_gene_sets[[row$Disease_Signature]]$N20

      score_N5  <- if (length(drug_N5)  > 0 & length(dis_N5)  > 0)
        compute_proximity_fast(string_graph, drug_N5,  dis_N5)  else NA_real_
      score_N10 <- if (length(drug_N10) > 0 & length(dis_N10) > 0)
        compute_proximity_fast(string_graph, drug_N10, dis_N10) else NA_real_
      score_N20 <- if (length(drug_N20) > 0 & length(dis_N20) > 0)
        compute_proximity_fast(string_graph, drug_N20, dis_N20) else NA_real_

      data.frame(
        row_idx           = i,
        Drug_Signature    = row$Drug_Signature,
        Disease_Signature = row$Disease_Signature,
        Proximity_N5      = score_N5,
        Proximity_N10     = score_N10,
        Proximity_N20     = score_N20,
        stringsAsFactors  = FALSE
      )
    }, error = function(e) {
      data.frame(
        row_idx           = i,
        Drug_Signature    = reversal$Drug_Signature[i],
        Disease_Signature = reversal$Disease_Signature[i],
        Proximity_N5      = NA_real_,
        Proximity_N10     = NA_real_,
        Proximity_N20     = NA_real_,
        stringsAsFactors  = FALSE
      )
    })
  }

  stopCluster(cl)
  gc()

  completed <- rbind(completed, chunk_results)
  saveRDS(completed, checkpoint_path)

  reversal_out <- reversal %>%
    dplyr::mutate(row_idx = dplyr::row_number()) %>%
    dplyr::left_join(
      completed %>% dplyr::select(row_idx, Proximity_N5, Proximity_N10, Proximity_N20),
      by = "row_idx"
    ) %>%
    dplyr::select(-row_idx)

  write_csv(reversal_out, temp_csv_path)
  file.rename(temp_csv_path, reversal_output_path)

  elapsed    <- toc(quiet = TRUE)$toc
  pairs_done <- nrow(completed)
  eta        <- (elapsed / pairs_done) * (nrow(reversal) - pairs_done) / 60
  cat(sprintf(
    "Chunk %d/%d | Completed: %d/%d | Elapsed: %.1f min | ETA: %.1f min\n",
    chunk_i, length(chunks), pairs_done, nrow(reversal),
    elapsed / 60, eta
  ))
}

cat("Run complete. Output saved to:", reversal_output_path, "\n")

