

suppressPackageStartupMessages({
  library(tidyverse)
  library(foreach)
  library(doParallel)
})

# ==============================================================================
# CMap-Style Reversal Score Calculator - Memantine vs. Brain Disease Signatures
# Same technique as the Aducanumab reversal script. Reads directly from the
# standardized folder (no curated "signature library" layer - not needed yet,
# since Memantine's (gse_id, genotype) jobs have no analogous control-type
# ambiguity that Aducanumab's isotype-vs-untreated choice required).
# ==============================================================================

cmap_score_new <- function(sig_up_genes, sig_down_genes, drug_signature_df, gamma = 1) {
  num_genes <- nrow(drug_signature_df)
  ks_up <- 0; ks_down <- 0; connectivity_score <- 0
  
  up_tags_position <- sort(drug_signature_df$rank[drug_signature_df$ids %in% sig_up_genes])
  down_tags_position <- sort(drug_signature_df$rank[drug_signature_df$ids %in% sig_down_genes])
  
  num_tags_up <- length(up_tags_position)
  num_tags_down <- length(down_tags_position)
  
  if(num_tags_up > 1) {
    a_up <- max(sapply(1:num_tags_up, function(j) j/num_tags_up - up_tags_position[j]/num_genes))
    b_up <- max(sapply(1:num_tags_up, function(j) up_tags_position[j]/num_genes - (j-1)/num_tags_up))
    ks_up <- ifelse(a_up > b_up, a_up, -b_up)
  }
  
  if (num_tags_down > 1){
    a_down <- max(sapply(1:num_tags_down, function(j) j/num_tags_down - down_tags_position[j]/num_genes))
    b_down <- max(sapply(1:num_tags_down, function(j) down_tags_position[j]/num_genes - (j-1)/num_tags_down))
    ks_down <- ifelse(a_down > b_down, a_down, -b_down)
  }
  
  if (ks_up == 0 & ks_down != 0){ connectivity_score <- -ks_down } 
  else if (ks_up != 0 & ks_down == 0){ connectivity_score <- gamma * ks_up } 
  else { connectivity_score <- gamma * ks_up - ks_down }
  
  return(connectivity_score)
}


# 2. PATHS
memantine_base_dir <- "/Users/palmerzs/Library/CloudStorage/OneDrive-MichiganStateUniversity/ChenLab/semaglutide_project/Full_Survey_Semaglutide/Aducunamab_Control/Memantine"
drug_sig_dir <- file.path(memantine_base_dir, "DE_Signatures_Standardized")
 
# Shared resources - same relative path as the Aducanumab reversal script
dz_root           <- "/Users/palmerzs/Library/CloudStorage/OneDrive-MichiganStateUniversity/ChenLab/semaglutide_project/Full_Survey_Semaglutide/DzSignatures2.4.2026"
disease_sig_dir   <- file.path(dz_root, "signatures_new")
disease_meta_file <- file.path(dz_root, "sig_meta_final.csv")
 
# Our own output
output_dir      <- file.path(memantine_base_dir, "Reversal_Signatures")
log_dir         <- file.path(output_dir, "Logs")
output_csv_path <- file.path(output_dir, "Memantine_Reversal_Scores.csv")
 
if (!dir.exists(output_dir)) dir.create(output_dir, recursive = TRUE)
if (!dir.exists(log_dir)) dir.create(log_dir, recursive = TRUE)
 
# 3. BRAIN-REGION KEYWORDS (same assumption as Aducanumab - verify tissue if unsure)
brain_keywords <- c(
  "Brain", "Brain_Basal_ganglia", "Brain_Cerebellum", "Brain_Cerebral_cortex",
  "Brain_Choroid_plexus", "Brain_Hippocampal_formation", "Brain_Midbrain",
  "Brain_Pons", "Brain_White_matter"
)
brain_pattern <- paste(brain_keywords, collapse = "|")
 
# 4. LOAD DISEASE METADATA + FILTER TO BRAIN
cat("Loading disease signature database...\n")
disease_meta_full <- read_csv(disease_meta_file, show_col_types = FALSE)
 
matching_disease_files <- disease_meta_full %>%
  dplyr::filter(str_detect(OrganRegion, regex(brain_pattern, ignore_case = TRUE)))
 
cat(sprintf("Found %d brain-related disease signatures (out of %d total).\n",
            nrow(matching_disease_files), nrow(disease_meta_full)))
 
# 5. DRUG FILES
drug_files <- list.files(drug_sig_dir, pattern = "_DESeq2_results.csv$", full.names = TRUE)
cat(sprintf("Found %d Memantine drug signature files.\n", length(drug_files)))
print(basename(drug_files))
 
# 6. ALWAYS OVERWRITE - no resume/skip logic. Every drug x disease pair is
# recomputed fresh on every run.
cat("Recomputing all pairs fresh (no resume) - prior results file will be fully overwritten.\n")
 
# 7. PARALLEL CLUSTER
num_cores <- max(1, parallel::detectCores() - 1)
cl <- makeCluster(num_cores)
registerDoParallel(cl)
cat(sprintf("Cluster active with %d cores. Processing %d drug files against %d disease signatures.\n",
            num_cores, length(drug_files), nrow(matching_disease_files)))
 
start_time <- Sys.time()
 
new_results_df <- foreach(
  drug_file_path = drug_files,
  .combine  = bind_rows,
  .packages = c("tidyverse", "stringr"),
  .export   = c("cmap_score_new", "matching_disease_files", "disease_sig_dir", "log_dir")
) %dopar% {
 
  drug_file_name <- basename(drug_file_path)
  current_key <- str_remove(drug_file_name, "_DESeq2_results.csv")
 
  log_file <- file.path(log_dir, paste0("Log_", current_key, ".txt"))
  writeLines(paste("Started processing:", current_key, "at", Sys.time()), log_file)
 
  drug_data <- read_csv(drug_file_path, show_col_types = FALSE)
 
  drug_sig <- drug_data %>%
    dplyr::filter(!is.na(Human_Ensembl)) %>%
    dplyr::group_by(Human_Ensembl) %>%
    dplyr::summarize(Value = median(log2FoldChange, na.rm = TRUE)) %>%
    dplyr::ungroup()
 
  cmap_exp_signature <- data.frame(
    ids  = drug_sig$Human_Ensembl,
    rank = -1 * rank(drug_sig$Value)
  )
  drug_gene_universe <- cmap_exp_signature$ids
 
  worker_results_list <- list()
 
  for (i in 1:nrow(matching_disease_files)) {
    disease_row <- matching_disease_files[i, ]
 
    disease_name <- NULL
    if ("Disease" %in% names(disease_row)) disease_name <- disease_row$Disease
    else if ("disease" %in% names(disease_row)) disease_name <- disease_row$disease
 
    disease_file_name <- NULL
    if ("File" %in% names(disease_row)) disease_file_name <- disease_row$File
    else if ("file" %in% names(disease_row)) disease_file_name <- disease_row$file
 
    if (length(disease_name) == 0 || is.na(disease_name) ||
        length(disease_file_name) == 0 || is.na(disease_file_name)) {
      cat(paste("\nWARNING: Missing Disease or File column for row", i), file = log_file, append = TRUE)
      next
    }
 
    disease_organ <- disease_row$OrganRegion
 
    if (i %% 10 == 0) cat(paste0("\n[", i, "/", nrow(matching_disease_files), "] Comparing: ", disease_name),
                          file = log_file, append = TRUE)
 
    disease_file_path <- file.path(disease_sig_dir, disease_name, disease_file_name)
    if (!file.exists(disease_file_path)) {
      cat(paste("\nSkipping missing file:", disease_file_path), file = log_file, append = TRUE)
      next
    }
 
    dz <- read_csv(disease_file_path, show_col_types = FALSE)
    dz <- dz %>% dplyr::filter(identifier %in% drug_gene_universe)
 
    dz_up   <- dz %>% dplyr::filter(log2FoldChange > 1 & padj < 0.05)
    dz_down <- dz %>% dplyr::filter(log2FoldChange < -1 & padj < 0.05)
 
    dz_up_genes   <- head(dz_up$identifier, min(nrow(dz_up), 500))
    dz_down_genes <- head(dz_down$identifier, min(nrow(dz_down), 500))
 
    up_len <- length(dz_up_genes); down_len <- length(dz_down_genes)
    if (up_len < 10 | down_len < 10) next
 
    raw_score <- cmap_score_new(dz_up_genes, dz_down_genes, cmap_exp_signature, gamma = 1)
 
    z_all <- numeric(5)
    for (rand_seed in 1:5) {
      set.seed(rand_seed)
      score_rd <- numeric(300)
      for (j in 1:300) {
        score_rd[j] <- cmap_score_new(
          sample(drug_gene_universe, up_len),
          sample(drug_gene_universe, down_len),
          cmap_exp_signature, gamma = 1
        )
      }
      null_mean <- mean(score_rd, na.rm = TRUE)
      null_sd   <- sd(score_rd, na.rm = TRUE)
      z_all[rand_seed] <- if (!is.na(null_sd) && null_sd != 0) (raw_score - null_mean) / null_sd else NA
    }
    z_score_median <- median(z_all, na.rm = TRUE)
 
    worker_results_list[[length(worker_results_list) + 1]] <- data.frame(
      Drug_Signature    = drug_file_name,
      Drug_Tissue       = "Brain",
      Disease_Signature = disease_file_name,
      Disease_Name      = disease_name,
      Disease_Tissue    = disease_organ,
      Raw_Score         = raw_score,
      Z_Score_Median    = z_score_median,
      Up_Genes_Used     = up_len,
      Down_Genes_Used   = down_len
    )
  }
 
  cat(paste0("\nFINISHED at ", Sys.time()), file = log_file, append = TRUE)
  bind_rows(worker_results_list)
}
 
# 8. CLEAN UP AND MERGE
stopCluster(cl)
end_time <- Sys.time()
cat(sprintf("\n--- Parallel Processing Complete in %s ---\n", round(end_time - start_time, 2)))
 
final_combined_df <- new_results_df
 
if (!is.null(final_combined_df) && nrow(final_combined_df) > 0) {
  final_combined_df <- final_combined_df %>% distinct() %>% arrange(Z_Score_Median)
  write_csv(final_combined_df, output_csv_path)
  cat(sprintf("Successfully OVERWROTE results at: %s\n", output_csv_path))
} else {
  cat("No results generated.\n")
}
