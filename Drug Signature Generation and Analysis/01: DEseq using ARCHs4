message(paste("Reading Main Metadata from:", CONFIG$meta_file))
meta <- read_excel(CONFIG$meta_file)

# 1. Load ARCHS4 Indices ONCE
message("Loading ARCHS4 master indices...")
archs4_samples <- trimws(h5read(CONFIG$archs4_h5, "meta/samples/geo_accession"))
archs4_genes   <- h5read(CONFIG$archs4_h5, "meta/genes")$symbol

# 2. Transform 'meta' (samples) into 'job_list' (signatures)
job_list <- meta %>%
  # Ensure we know where data comes from
  dplyr::mutate(in_archs4 = Sample_ID %in% archs4_samples) %>% 
  dplyr::group_by(Key) %>%
  dplyr::summarise(
    # FIX: Use dplyr::first to avoid S4Vectors conflict
    gse_id = dplyr::first(gse_id),
    path = dplyr::first(path),
    gene_col = dplyr::first(gene_col),
    gene_id_type = dplyr::first(gene_id_type),
    
    # LOGIC UPDATE: Determine source
    data_source = ifelse(any(in_archs4), "ARCHS4", "BACKUP"), 
    
    # *** CRITICAL FIX HERE ***
    # If the source is BACKUP, grab 'Sample_ID_backup'. If ARCHS4, grab 'Sample_ID'.
    cases = list(
      if(unique(data_source) == "BACKUP") {
        Sample_ID_backup[Group_Type == "Case"]
      } else {
        Sample_ID[Group_Type == "Case"]
      }
    ),
    
    controls = list(
      if(unique(data_source) == "BACKUP") {
        Sample_ID_backup[Group_Type == "Control"]
      } else {
        Sample_ID[Group_Type == "Control"]
      }
    ),
    .groups = "drop"
  )

message(paste("Prepared job list for", nrow(job_list), "signatures."))
print(table(job_list$data_source))

# ==============================================================================
# SECTION 3: THE UNIFIED GRAND LOOP
# ==============================================================================

if (!dir.exists(CONFIG$out_dir)) dir.create(CONFIG$out_dir, recursive = TRUE)

results_summary <- list()

for (i in 1:nrow(job_list)) {
  job <- job_list[i, ]
  
  # Define Output Prefix
  out_prefix <- file.path(CONFIG$out_dir, job$Key)
  
  # Skip if done
  if (file.exists(paste0(out_prefix, "_DESeq2_results.csv"))) {
    message(sprintf("[%d/%d] Skipping %s (Results exist)", i, nrow(job_list), job$Key))
    next
  }
  
  message(sprintf("\n[%d/%d] Processing %s | Source: %s", i, nrow(job_list), job$Key, job$data_source))
  
  # ERROR HANDLING WRAPPER
  tryCatch({
    
    # ----------------------------------------------------
    # BRANCH 1: ARCHS4 EXTRACTION (Updated for Partials)
    # ----------------------------------------------------
    if (job$data_source == "ARCHS4") {
      message("   -> [VERBOSE] Branch: ARCHS4 Extraction")
      
      # 1. Identify which samples we WANTED vs which we HAVE
      wanted_samples <- c(unlist(job$cases), unlist(job$controls))
      
      # Intersect finds only the samples that actually exist in the master list
      # This effectively drops the "missing" GSM from the request list
      valid_samples <- intersect(wanted_samples, archs4_samples)
      
      # Sanity Check: Did we lose too many?
      if (length(valid_samples) < length(wanted_samples)) {
        lost <- setdiff(wanted_samples, valid_samples)
        message(paste("   -> Note: Dropping", length(lost), "missing sample(s) from ARCHS4 query:", paste(lost, collapse=", ")))
      }
      
      # 2. Get Indices for valid samples only
      idx <- match(valid_samples, archs4_samples)
      
      # 3. Extract
      message(sprintf("   -> [VERBOSE] Extracting data from H5 for %d samples...", length(valid_samples)))
      subset_counts <- h5read(CONFIG$archs4_h5, "data/expression", 
                              index = list(idx, 1:length(archs4_genes)))
      
      # 4. Format
      cnts <- t(subset_counts)
      rownames(cnts) <- archs4_genes
      colnames(cnts) <- valid_samples # Use valid_samples, not wanted_samples
      
      # 5. Prepare metadata
      # make_coldata will handle the fact that 'colnames(cnts)' is smaller than 'cases/controls' lists
      coldata <- make_coldata(colnames(cnts), unlist(job$cases), unlist(job$controls), job$gse_id)
      
      # 6. Run Analysis
      res <- run_deseq_single(cnts, coldata, 
                              gene_id_type = "symbol", 
                              gse_id = job$gse_id, 
                              out_prefix = out_prefix)
      results_summary[[job$Key]] <- res$results
      
    # ----------------------------------------------------
    # BRANCH 2: BACKUP FILE READING
    # ----------------------------------------------------
    } else {
      message("   -> [VERBOSE] Branch: Backup File Read")
      
      # Read File
      cnts <- safe_read_counts(job$path, gene_col = job$gene_col)
      
      # Validate Samples Exist
      wanted <- c(unlist(job$cases), unlist(job$controls))
      missing <- setdiff(wanted, colnames(cnts))
      
      # For backup files, we are stricter: if samples are missing here, the file might be wrong.
      if (length(missing) > 0) {
        stop(paste("Samples missing from backup file:", paste(missing, collapse=", ")))
      }
      
      # Subset
      cnts <- cnts[, wanted, drop = FALSE]
      
      # Prepare metadata
      coldata <- make_coldata(colnames(cnts), unlist(job$cases), unlist(job$controls), job$gse_id)
      
      # Run Analysis
      res <- run_deseq_single(cnts, coldata, 
                              gene_id_type = job$gene_id_type, 
                              gse_id = job$gse_id, 
                              out_prefix = out_prefix)
      results_summary[[job$Key]] <- res$results
    }
    
  }, error = function(e) {
    message(paste("   !!! ERROR processing Key:", job$Key))
    message(paste("   !!! Message:", e$message))
  })
}

