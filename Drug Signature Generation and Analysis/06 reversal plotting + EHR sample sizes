      data   = raw_sub,
      aes(x = Z_Score_Median, y = Disease_Name),
      height = 0.18, width = 0,
      alpha  = 0.25, color = "grey55", size = 0.7, shape = 16
    ) +
    geom_point(aes(color = bar_color), size = 2.8, shape = 16) +
    scale_color_identity() +
    scale_x_continuous(limits = c(-5, 5), breaks = seq(-4, 4, by = 2)) +
    labs(x = "Median Z-Score", y = NULL) +
    theme_bw(base_size = 9) +
    theme(
      panel.grid.major.y = element_line(color = "grey93"),
      panel.grid.minor   = element_blank(),
      axis.text.y        = element_text(size = 7),
      axis.text.x        = element_text(size = 7)
    )
