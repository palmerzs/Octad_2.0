create_forest_panel <- function(data_subset) {
  raw_sub <- plot_data_raw %>%
    filter(Disease_Name %in% data_subset$Disease_Name) %>%
    mutate(Disease_Name = factor(Disease_Name, levels = levels(data_subset$Disease_Name)))

