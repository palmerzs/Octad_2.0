create_bar_panel <- function(data_ss) {
  plot_df <- data_ss %>%
    mutate(
      sample_size_plot = ifelse(is.na(sample_size) | sample_size == 0, NA, sample_size),
      bar_alpha        = ifelse(is.na(sample_size), 0, 1)
    )

  ggplot(plot_df, aes(x = sample_size_plot, y = Disease_Name)) +
    geom_col(
      aes(alpha = bar_alpha),
      fill  = "#5D6D7E",
      width = 0.6
    ) +
    scale_alpha_identity() +
    scale_x_sqrt(
      limits = c(0, max_sample_size * 1.1),
      labels = scales::comma,
      expand = c(0, 0)
    ) +
    labs(x = "Sample Size (N, sqrt scale)", y = NULL) +
    theme_bw() +
    theme(
      panel.grid.major.y = element_line(color = "grey95"),
      panel.grid.minor   = element_blank(),
      axis.text.y        = element_blank(),
      axis.ticks.y       = element_blank(),
      axis.text.x        = element_text(size = 7)
    )
}

# ── 3. MAIN GENERATOR FUNCTION ─────────────────────────────────────────────────
generate_forest_with_samplesize <- function(stats_data, stats_data_ss, raw_data,
                                            sort_var, plot_var, x_label, filename) {
  sorted <- stats_data %>%
    arrange(.data[[sort_var]]) %>%
    mutate(Disease_Name = factor(Disease_Name, levels = Disease_Name))

  halfway    <- ceiling(nrow(sorted) / 2)
  left_names  <- levels(sorted$Disease_Name)[1:halfway]
  right_names <- levels(sorted$Disease_Name)[(halfway + 1):nrow(sorted)]

  left_data  <- sorted %>% filter(Disease_Name %in% left_names)  %>% mutate(Disease_Name = factor(Disease_Name, levels = left_names))
  right_data <- sorted %>% filter(Disease_Name %in% right_names) %>% mutate(Disease_Name = factor(Disease_Name, levels = right_names))
  left_ss    <- stats_data_ss %>% filter(Disease_Name %in% left_names)  %>% mutate(Disease_Name = factor(Disease_Name, levels = left_names))
  right_ss   <- stats_data_ss %>% filter(Disease_Name %in% right_names) %>% mutate(Disease_Name = factor(Disease_Name, levels = right_names))

  p_forest_left  <- create_forest_panel(left_data)
  p_bar_left     <- create_bar_panel(left_ss)
  p_forest_right <- create_forest_panel(right_data)
  p_bar_right    <- create_bar_panel(right_ss)

  col_height <- 1.5 + (0.16 * halfway)

  final_plot <- plot_grid(
    p_forest_left, p_bar_left, p_forest_right, p_bar_right,
    ncol       = 4,
    align      = "h",
    axis       = "tb",
    rel_widths = c(2, 1, 2, 1)
  )

  ggsave(file.path(output_plot_dir, filename), final_plot, width = 20, height = col_height, limitsize = FALSE)
  cat(paste("Saved:", filename, "\n"))
}

# ── 4. EXECUTE ─────────────────────────────────────────────────────────────────
generate_forest_with_samplesize(
  stats_data    = stats_df,
  stats_data_ss = stats_df_with_ss,
  raw_data      = plot_data_raw,
  sort_var      = "median",
  plot_var      = "median",
  x_label       = "Median Z-Score",
  filename      = "AForest_Plot_WithSampleSize.png"
)

