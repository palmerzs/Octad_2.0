input_sheet <- "S3 Sema_Dox_Sglt2i_reversal"
input_skip  <- 1

TOP_N      <- 3
NO_TERMS   <- "no terms tested"      # marker for empty/skipped directions
ID_KEEP    <- c("perturbation", "Drug_Signature", "Disease_Signature",
                "Disease_Name")      # pair-identifying cols carried through

stopifnot(file.exists(rds_path), file.exists(input_xlsx))

