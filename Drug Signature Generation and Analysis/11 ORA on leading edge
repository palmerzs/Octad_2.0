# --- 2. Saved enrichResult objects, keyed "row_id|direction" -----------------
store <- readRDS(rds_path)

# Top-N (by raw pvalue) terms from one object's FULL @result table.
top_terms <- function(key, n = TOP_N) {
  obj <- store[[key]]
  if (is.null(obj)) return(NULL)
  df <- obj@result
  if (is.null(df) || nrow(df) == 0) return(NULL)
  df %>%
    as_tibble() %>%
    arrange(pvalue, p.adjust) %>%
    slice_head(n = n) %>%
    dplyr::select(Description, pvalue, p.adjust, qvalue, Count)
}

# Flatten one direction's top-N into a single named wide row:
#   <dir>1_Description, <dir>1_pvalue, ... <dir>N_Count
# Missing slots (fewer than N terms, or none) are filled: first slot gets the
# NO_TERMS marker when there were truly no terms; extra empty slots stay NA.
flatten_dir <- function(tt, dir, n = TOP_N) {
  out <- list()
  for (i in seq_len(n)) {
    pfx <- sprintf("%s%d_", dir, i)
    if (!is.null(tt) && i <= nrow(tt)) {
      out[[paste0(pfx, "Description")]] <- tt$Description[i]
      out[[paste0(pfx, "pvalue")]]      <- tt$pvalue[i]
      out[[paste0(pfx, "p.adjust")]]    <- tt$p.adjust[i]
      out[[paste0(pfx, "qvalue")]]      <- tt$qvalue[i]
      out[[paste0(pfx, "Count")]]       <- tt$Count[i]
    } else {
      out[[paste0(pfx, "Description")]] <-
        if (is.null(tt) && i == 1) NO_TERMS else NA_character_
      out[[paste0(pfx, "pvalue")]]   <- NA_real_
      out[[paste0(pfx, "p.adjust")]] <- NA_real_
      out[[paste0(pfx, "qvalue")]]   <- NA_real_
      out[[paste0(pfx, "Count")]]    <- NA_integer_
    }
  }
  as_tibble(out)
}

# --- 3. Build one wide row per pair ------------------------------------------
wide_rows <- map_df %>%
  mutate(.rn = row_number()) %>%
  group_split(.rn) %>%
  map_dfr(function(r) {
    rid <- r$row_id
    up_tt   <- top_terms(paste(rid, "up",   sep = "|"))
    down_tt <- top_terms(paste(rid, "down", sep = "|"))
    ids <- r %>% dplyr::select(row_id, all_of(id_cols_present))
    bind_cols(ids, flatten_dir(up_tt, "up"), flatten_dir(down_tt, "down"))
  })

