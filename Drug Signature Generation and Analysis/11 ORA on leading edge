# -----------------------------------------------------------------------------
# 3. ANALYSIS HELPERS (identical logic to the serial version)
# -----------------------------------------------------------------------------
split_le <- function(cell) {
  if (is.na(cell) || str_trim(cell) == "") return(character(0))
  toks <- str_trim(str_split(cell, fixed(LE_DELIM))[[1]]); toks[toks != ""]
}
GO_OUT_COLS <- c("ID","Description","GeneRatio","BgRatio",
                 "pvalue","p.adjust","qvalue","geneID","Count")

make_result_block <- function(meta, status, enrich_obj = NULL) {
  if (!is.null(enrich_obj) && nrow(as.data.frame(enrich_obj)) > 0) {
    res <- as.data.frame(enrich_obj)[, GO_OUT_COLS, drop = FALSE]
    cbind(meta[rep(1, nrow(res)), , drop = FALSE],
          data.frame(status = "enriched", stringsAsFactors = FALSE), res, row.names = NULL)
  } else {
    na_block <- as.data.frame(setNames(rep(list(NA), length(GO_OUT_COLS)), GO_OUT_COLS),
                              stringsAsFactors = FALSE)
    cbind(meta, data.frame(status = status, stringsAsFactors = FALSE), na_block, row.names = NULL)
  }
}

read_drug_universe <- function(perturbation, drug_file_name, dirs) {
  base_dir <- dirs[[perturbation]]
  if (is.null(base_dir) || is.na(base_dir) || !dir.exists(base_dir))
    return(list(ok = FALSE, reason = sprintf("perturbation '%s' has no resolvable dir", perturbation)))
  fpath <- file.path(base_dir, drug_file_name)
  if (!file.exists(fpath))
    return(list(ok = FALSE, reason = sprintf("drug signature file not found: %s", fpath)))
  dd <- suppressWarnings(readr::read_csv(fpath, show_col_types = FALSE))
  if (!"Human_Ensembl" %in% names(dd))
    return(list(ok = FALSE, reason = sprintf("no 'Human_Ensembl' column: %s", fpath)))
  uni <- dd %>% filter(!is.na(Human_Ensembl)) %>% distinct(Human_Ensembl) %>% pull(Human_Ensembl)
  list(ok = TRUE, universe = uni)
}

# -----------------------------------------------------------------------------
# 4. PER-ROW WORKER FUNCTION (writes its own parts, flag last)
# -----------------------------------------------------------------------------
process_one_row <- function(row, dirs, parts_dir, P, Q, ONT, MINLE,
                            up_col, dn_col, delim) {
  rid <- row$row_id
  meta <- data.frame(row_id = rid, perturbation = row$perturbation,
                     Drug_Signature = row$Drug_Signature,
                     Disease_Signature = row$Disease_Signature,
                     Disease_Name = row$Disease_Name, stringsAsFactors = FALSE)

  blocks <- list(); obj_list <- list(); notes <- character(0)
  GO_OUT_COLS <- c("ID","Description","GeneRatio","BgRatio",
                   "pvalue","p.adjust","qvalue","geneID","Count")

  .split <- function(cell) {
    if (is.na(cell) || trimws(cell) == "") return(character(0))
    t <- trimws(strsplit(cell, delim, fixed = TRUE)[[1]]); t[t != ""]
  }
  .block <- function(m, status, eo = NULL) {
    if (!is.null(eo) && nrow(as.data.frame(eo)) > 0) {
      res <- as.data.frame(eo)[, GO_OUT_COLS, drop = FALSE]
      cbind(m[rep(1, nrow(res)), , drop = FALSE],
            data.frame(status = "enriched", stringsAsFactors = FALSE), res, row.names = NULL)
    } else {
      nb <- as.data.frame(setNames(rep(list(NA), length(GO_OUT_COLS)), GO_OUT_COLS),
                          stringsAsFactors = FALSE)
      cbind(m, data.frame(status = status, stringsAsFactors = FALSE), nb, row.names = NULL)
    }
  }

  ur <- read_drug_universe(row$perturbation, row$Drug_Signature, dirs)
  if (!isTRUE(ur$ok)) {
    notes <- c(notes, sprintf("UNRESOLVED: %s", ur$reason))
    for (dl in c("up","down")) {
      m <- cbind(meta, data.frame(direction = dl, database = "GO_BP", stringsAsFactors = FALSE))
      blocks[[length(blocks)+1]] <- .block(m, "unresolved_universe")
    }
  } else {
    universe <- ur$universe
    le_cols <- c(up = up_col, down = dn_col)
    for (dl in names(le_cols)) {
      genes <- .split(row[[ le_cols[[dl]] ]])
      gin <- intersect(genes, universe)
      m <- cbind(meta, data.frame(direction = dl, database = "GO_BP", stringsAsFactors = FALSE))
      if (length(gin) < MINLE) {
        notes <- c(notes, sprintf("%s: SKIPPED %d gene(s) in universe", dl, length(gin)))
        blocks[[length(blocks)+1]] <- .block(m, "skipped_too_few_genes"); next
      }
      ego <- tryCatch(
        clusterProfiler::enrichGO(gene = gin, universe = universe, OrgDb = org.Hs.eg.db,
                                  keyType = "ENSEMBL", ont = ONT,
                                  pvalueCutoff = P, qvalueCutoff = Q, readable = TRUE),
        error = function(e) { notes <<- c(notes, sprintf("%s: enrichGO ERROR %s", dl, conditionMessage(e))); NULL })
      if (is.null(ego)) { blocks[[length(blocks)+1]] <- .block(m, "enrichGO_error"); next }
      obj_list[[paste(rid, dl, sep = "|")]] <- ego
      blocks[[length(blocks)+1]] <-
        if (nrow(as.data.frame(ego)) == 0) .block(m, "no_enrichment", ego) else .block(m, "enriched", ego)
    }
  }

  tidy_row <- dplyr::bind_rows(blocks)
  readr::write_csv(tidy_row, file.path(parts_dir, sprintf("ora_part_%d.csv", rid)))
  saveRDS(obj_list,        file.path(parts_dir, sprintf("ora_obj_%d.rds",  rid)))
  if (length(notes) > 0)
    writeLines(paste0("[row ", rid, "] ", notes), file.path(parts_dir, sprintf("note_%d.txt", rid)))
  writeLines(format(Sys.time()), file.path(parts_dir, sprintf("done_%d.flag", rid)))  # flag LAST
  invisible(TRUE)
}

# -----------------------------------------------------------------------------
# 5. PARALLEL RUN WITH PROGRESS BAR
# -----------------------------------------------------------------------------
if (nrow(todo_df) > 0) {
  plan(multisession, workers = N_WORKERS)
  # Use non-global progress handling (with_progress below). Do NOT call
  # handlers(global = TRUE): in global mode progressr installs a calling handler
  # on the session stack and errors ("should not be called with handlers on the
  # stack") when re-run in the same session, inside knitr, or after an
  # interrupted run. with_progress() is the safe, re-runnable idiom.
  handlers("txtprogressbar")
  row_list <- todo_df %>% group_split(row_id)

  with_progress({
    p <- progressor(steps = length(row_list))
    future_walk(row_list, function(r) {
      process_one_row(r, drug_sig_dirs, parts_dir, P_CUTOFF, Q_CUTOFF, GO_ONT,
                      MIN_LE_GENES, LE_UP_COL, LE_DOWN_COL, LE_DELIM)
      p()  # advance bar as each row completes
    }, .options = furrr_options(seed = TRUE))
  })
  plan(sequential)
  cat("\nDispatched rows complete.\n")
} else {
  cat("All rows were already complete; proceeding to reassembly.\n")
}

# -----------------------------------------------------------------------------
# 6. REASSEMBLE FINAL OUTPUTS (only if everything is done)
# -----------------------------------------------------------------------------
n_done <- length(list.files(parts_dir, pattern = "^done_\\d+\\.flag$"))
if (n_done < nrow(map_df)) {
  cat(sprintf("\n%d / %d rows done. Re-run this chunk to finish the rest before reassembly.\n",
              n_done, nrow(map_df)))
} else {
  cat("\nAll rows complete -- reassembling final outputs...\n")

  part_csvs <- list.files(parts_dir, pattern = "^ora_part_\\d+\\.csv$", full.names = TRUE)
  tidy_results <- part_csvs %>%
    map(~ suppressWarnings(read_csv(.x, show_col_types = FALSE,
                                    col_types = cols(.default = col_character())))) %>%
    bind_rows()
  for (cc in intersect(c("pvalue","p.adjust","qvalue","Count","row_id"), names(tidy_results)))
    tidy_results[[cc]] <- suppressWarnings(as.numeric(tidy_results[[cc]]))
  tidy_results <- tidy_results %>% arrange(row_id, direction, is.na(p.adjust), p.adjust)
  write_csv(tidy_results, out_table_path)

  part_rds <- list.files(parts_dir, pattern = "^ora_obj_\\d+\\.rds$", full.names = TRUE)
  enrich_store <- list()
  for (pp in part_rds) {
    o <- tryCatch(readRDS(pp), error = function(e) NULL)
    if (!is.null(o) && length(o) > 0) enrich_store <- c(enrich_store, o)
  }
  saveRDS(enrich_store, out_rds_path)

  note_files <- list.files(parts_dir, pattern = "^note_\\d+\\.txt$", full.names = TRUE)
  all_notes  <- if (length(note_files) > 0) unlist(lapply(note_files, readLines)) else character(0)
  status_counts <- tidy_results %>% count(status, name = "n")

  log_lines <- c("================ PER-ROW GO:BP ORA -- SUMMARY ================",
    sprintf("Rows in table   : %d", nrow(map_df)),
    sprintf("Tidy rows total : %d", nrow(tidy_results)),
    sprintf("Raw objects     : %d", length(enrich_store)),
    "", "--- Status breakdown (per direction-test) ---",
    apply(status_counts, 1, function(r) sprintf("  %-22s %s", r[["status"]], r[["n"]])))
  if (length(all_notes) > 0)
    log_lines <- c(log_lines, "", sprintf("--- Worker notes (%d) ---", length(all_notes)), all_notes)
  log_lines <- c(log_lines, "", "=============================================================")
  writeLines(log_lines, out_log_path)
  cat(paste(log_lines, collapse = "\n"), "\n")

  cat(sprintf("\nFinal outputs written to:\n  %s\n  %s\n  %s\n",
              out_table_path, out_rds_path, out_log_path))
}


