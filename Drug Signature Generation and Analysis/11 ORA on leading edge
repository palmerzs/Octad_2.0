resolve_dir <- function(path) {
  if (dir.exists(path)) return(path)
  parent <- dirname(path); target <- basename(path)
  if (dir.exists(parent)) {
    hits <- list.files(parent, full.names = TRUE)
    m <- hits[tolower(basename(hits)) == tolower(target) & dir.exists(hits)]
    if (length(m) == 1) return(m)
  }
  path
}
