# --- METHOD C PARAMETERS ------------------------------------------------------
# Fraction of the KS gap the reported leading edge must cumulatively cover.
# 0.90 = "smallest set of genes explaining 90% of the score".
LE_CONTRIB_FRAC <- 0.95

# Tolerance for the internal assertion that per-gene contributions telescope
# to the KS value. This is a correctness self-check, not a scoring tolerance.
LE_TELESCOPE_TOL <- 1e-9
# -----------------------------------------------------------------------------

select_cumulative <- function(contrib, gap, frac) {
  if (length(contrib) == 0) return(integer(0))
  if (!is.finite(gap) || gap == 0) return(seq_along(contrib))
  target <- frac * gap
  ord <- order(contrib, decreasing = TRUE)      # most responsible first
  cum <- cumsum(contrib[ord])
  # first position where cumulative >= target
  hit <- which(cum >= target)
  k   <- if (length(hit) == 0) length(contrib) else hit[1]
  sort(ord[seq_len(k)])                          # back to ascending block order
}

ks_arm_with_leading_edge <- function(tags_position_sorted, num_genes,
                                     contrib_frac = LE_CONTRIB_FRAC) {
  n <- length(tags_position_sorted)
  if (n <= 1) {
    return(list(ks = 0, branch = NA_character_,
                le_idx = integer(0), le_full = integer(0),
                gap = 0, contrib_sum_ok = TRUE))
  }

  N   <- num_genes
  pos <- tags_position_sorted

  # a-term deviations at each sorted hit j: j/n - pos[j]/N
  a_vec <- vapply(seq_len(n),
                  function(j) j / n - pos[j] / N,
                  numeric(1))
  # b-term deviations at each sorted hit j: pos[j]/N - (j-1)/n
  b_vec <- vapply(seq_len(n),
                  function(j) pos[j] / N - (j - 1) / n,
                  numeric(1))

  a_up <- max(a_vec)
  b_up <- max(b_vec)

  # EXACT same decision as cmap_score_new: ifelse(a > b, a, -b)
  if (a_up > b_up) {
    ks      <- a_up
    branch  <- "a"
    jstar   <- which.max(a_vec)
    le_full <- seq_len(jstar)                    # OLD definition (full block)

    # --- Method C on the "a" arm -------------------------------------------
    # Per-gene contribution c_j = 1/n - (pos[j]-pos[j-1])/N, j = 1..jstar,
    # with pos[0] := 0. These telescope EXACTLY to a_vec[jstar] = ks.
    pj   <- pos[seq_len(jstar)]
    pjm1 <- c(0, pos[seq_len(jstar - 1)])        # pos[0]:=0, then pos[1..jstar-1]
    contrib <- (1 / n) - (pj - pjm1) / N
    gap     <- ks

    sel <- select_cumulative(contrib, gap, contrib_frac)
    le_idx <- sel                                # already in ascending order

  } else {
    ks      <- -b_up
    branch  <- "b"
    jstar   <- which.max(b_vec)
    le_full <- seq.int(jstar, n)                 

    
    blk   <- seq.int(jstar, n)
    pj    <- pos[blk]
    pjp1  <- c(pos[blk[-1]], N)                  # pos[j+1], with pos[n+1]:=N
    contrib_desc <- (pjp1 - pj) / N - (1 / n)    # telescopes to -G_b
    gap_desc     <- sum(contrib_desc)            # == -b_up (negative)


    sel <- select_cumulative(-contrib_desc, -gap_desc, contrib_frac)
    le_idx <- blk[sel]
    # For the telescoping self-check we report against the true KS magnitude:
    gap <- ks
    contrib <- contrib_desc                      # used only for the assert
  }


  contrib_sum_ok <- if (branch == "a") {
    abs(sum(contrib) - ks) < LE_TELESCOPE_TOL
  } else {
    abs(sum(contrib) - (-abs(ks))) < LE_TELESCOPE_TOL   # descent == -|gap|
  }

  list(ks = ks, branch = branch,
       le_idx = le_idx, le_full = le_full,
       gap = ks, contrib_sum_ok = contrib_sum_ok)
}

# Full scorer mirroring cmap_score_new, but also surfacing leading edges.
# `drug_signature_df` has columns: ids, rank   (rank already = -1*rank(Value))
cmap_score_with_le <- function(sig_up_genes, sig_down_genes,
                                drug_signature_df, gamma = 1,
                                contrib_frac = LE_CONTRIB_FRAC) {
  num_genes <- nrow(drug_signature_df)


  up_sel  <- drug_signature_df$ids %in% sig_up_genes
  dn_sel  <- drug_signature_df$ids %in% sig_down_genes

  up_pos_raw  <- drug_signature_df$rank[up_sel]
  up_ids_raw  <- drug_signature_df$ids[up_sel]
  dn_pos_raw  <- drug_signature_df$rank[dn_sel]
  dn_ids_raw  <- drug_signature_df$ids[dn_sel]

  up_ord <- order(up_pos_raw)   # order() == the ordering sort() would apply
  dn_ord <- order(dn_pos_raw)

  up_pos <- up_pos_raw[up_ord]; up_ids <- up_ids_raw[up_ord]
  dn_pos <- dn_pos_raw[dn_ord]; dn_ids <- dn_ids_raw[dn_ord]

  num_tags_up   <- length(up_pos)
  num_tags_down <- length(dn_pos)

  ks_up   <- 0; up_branch <- NA_character_
  up_le_genes <- character(0); up_full_size <- 0L; up_ok <- TRUE
  ks_down <- 0; dn_branch <- NA_character_
  dn_le_genes <- character(0); dn_full_size <- 0L; dn_ok <- TRUE

  if (num_tags_up > 1) {
    r <- ks_arm_with_leading_edge(up_pos, num_genes, contrib_frac)
    ks_up        <- r$ks
    up_branch    <- r$branch
    up_le_genes  <- up_ids[r$le_idx]
    up_full_size <- length(r$le_full)
    up_ok        <- r$contrib_sum_ok
  }

  if (num_tags_down > 1) {
    r <- ks_arm_with_leading_edge(dn_pos, num_genes, contrib_frac)
    ks_down      <- r$ks
    dn_branch    <- r$branch
    dn_le_genes  <- dn_ids[r$le_idx]
    dn_full_size <- length(r$le_full)
    dn_ok        <- r$contrib_sum_ok
  }

  # EXACT same combination logic as cmap_score_new
  if (ks_up == 0 & ks_down != 0) {
    connectivity_score <- -ks_down
  } else if (ks_up != 0 & ks_down == 0) {
    connectivity_score <- gamma * ks_up
  } else {
    connectivity_score <- gamma * ks_up - ks_down
  }

  list(
    score          = connectivity_score,
    ks_up          = ks_up,
    ks_down        = ks_down,
    up_branch      = up_branch,
    down_branch    = dn_branch,
    up_le_genes    = up_le_genes,
    down_le_genes  = dn_le_genes,
    up_full_size   = up_full_size,
    down_full_size = dn_full_size,
    contrib_ok     = up_ok && dn_ok
  )
}



