row_note           <- rep("", n)

classify_tier <- function(d) {
  if (is.na(d)) return("Unresolved")
  if (d == 0) return("Exact")
  if (abs(d) < SCORE_TOL) return("Negligible")
  "Material"
}

pb_every <- max(1, floor(n / 50))

for (k in seq_len(n)) {
  perturbation <- map_df$perturbation[k]
  drug_file    <- map_df$Drug_Signature[k]
  disease_name <- map_df$Disease_Name[k]
  disease_file <- map_df$Disease_Signature[k]
  stored_score <- map_df$Raw_Score[k]

  drug_signature_df <- get_drug_signature(perturbation, drug_file)
  if (length(drug_signature_df) == 1 && is.na(drug_signature_df)[1]) {
    score_tier[k] <- "Unresolved"
    row_note[k]   <- "drug signature file/dir not found"
    next
  }
  drug_gene_universe <- drug_signature_df$ids

  dz_res  <- resolve_disease_path(disease_file)
  dz_path <- dz_res$path
  if (!file.exists(dz_path)) {
    score_tier[k] <- "Unresolved"
    row_note[k]   <- if (!dz_res$folder_exists) {
      sprintf("derived disease folder '%s' not found on disk", dz_res$folder)
    } else {
      "disease signature file not found in its folder"
    }
    next
  }

  dz <- read_csv(dz_path, show_col_types = FALSE) %>%
    filter(identifier %in% drug_gene_universe)

  dz_up   <- dz %>% filter(log2FoldChange >  1 & padj < 0.05)
  dz_down <- dz %>% filter(log2FoldChange < -1 & padj < 0.05)

  dz_up_genes   <- head(dz_up$identifier,   min(nrow(dz_up),   500))
  dz_down_genes <- head(dz_down$identifier, min(nrow(dz_down), 500))

  up_len   <- length(dz_up_genes)
  down_len <- length(dz_down_genes)

  up_count_check[k] <- if (!is.na(map_df$Up_Genes_Used[k]) &&
                           up_len == map_df$Up_Genes_Used[k]) "match" else "MISMATCH"
  down_count_check[k] <- if (!is.na(map_df$Down_Genes_Used[k]) &&
                             down_len == map_df$Down_Genes_Used[k]) "match" else "MISMATCH"

  if (up_len < 10 | down_len < 10) {
    score_tier[k] <- "Unresolved"
    row_note[k]   <- sprintf("below-threshold gene counts (up=%d, down=%d)", up_len, down_len)
    next
  }

  res <- cmap_score_with_le(dz_up_genes, dz_down_genes, drug_signature_df,
                            gamma = 1, contrib_frac = LE_CONTRIB_FRAC)

  recomputed_score[k]    <- res$score
  score_diff[k]          <- res$score - stored_score
  score_tier[k]          <- classify_tier(score_diff[k])
  le_up_branch[k]        <- res$up_branch
  le_down_branch[k]      <- res$down_branch
  le_up_size[k]          <- length(res$up_le_genes)
  le_down_size[k]        <- length(res$down_le_genes)
  le_up_full_size[k]     <- res$up_full_size
  le_down_full_size[k]   <- res$down_full_size
  contrib_ok_vec[k]      <- res$contrib_ok
  le_up_serialized[k]    <- paste(res$up_le_genes,   collapse = LE_DELIM)
  le_down_serialized[k]  <- paste(res$down_le_genes, collapse = LE_DELIM)

  if (k %% pb_every == 0 || k == n) {
    cat(sprintf("\r  processed %d / %d rows", k, n)); flush.console()
  }
}
