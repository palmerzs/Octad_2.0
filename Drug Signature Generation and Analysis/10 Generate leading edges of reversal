get_drug_signature <- function(perturbation, drug_file_name) {
  cache_key <- paste(perturbation, drug_file_name, sep = "||")
  if (!is.null(drug_cache[[cache_key]])) return(drug_cache[[cache_key]])

  base_dir <- drug_sig_dirs[[perturbation]]
  if (is.null(base_dir) || is.na(base_dir)) {
    drug_cache[[cache_key]] <- NA
    return(NA)
  }
  fpath <- file.path(base_dir, drug_file_name)
  if (!file.exists(fpath)) {
    drug_cache[[cache_key]] <- NA
    return(NA)
  }

  drug_data <- read_csv(fpath, show_col_types = FALSE)
  drug_sig <- drug_data %>%
    filter(!is.na(Human_Ensembl)) %>%
    group_by(Human_Ensembl) %>%
    summarize(Value = median(log2FoldChange, na.rm = TRUE), .groups = "drop")

  prepared <- data.frame(
    ids  = drug_sig$Human_Ensembl,
    rank = -1 * rank(drug_sig$Value),   # IDENTICAL to original orientation
    stringsAsFactors = FALSE
  )
  drug_cache[[cache_key]] <- prepared
  prepared
}

