# -----------------------------------------------------------------------------
# 3. CONVERSION HELPER
# -----------------------------------------------------------------------------
# Convert one serialized Ensembl list -> serialized symbol list.
# Unmapped IDs fall back to the original Ensembl ID (gene not dropped).
convert_le <- function(ens_string) {
  if (is.na(ens_string) || ens_string == "") return(ens_string)
  ids <- strsplit(ens_string, LE_DELIM, fixed = TRUE)[[1]]
  syms <- ens2sym[ids]
  # Fallback: where no symbol (NA from lookup, i.e. ID absent or symbol NA),
  # keep the original Ensembl ID so positions stay aligned and complete.
  out <- ifelse(is.na(syms), ids, unname(syms))
  paste(out, collapse = LE_DELIM)
}

