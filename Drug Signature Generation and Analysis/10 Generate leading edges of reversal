existing_disease_folders <- if (dir.exists(disease_sig_dir)) {
  list.dirs(disease_sig_dir, full.names = FALSE, recursive = FALSE)
} else character(0)

derive_disease_folder <- function(disease_file) {
  sub("_.*$", "", disease_file)
}

resolve_disease_path <- function(disease_file) {
  folder <- derive_disease_folder(disease_file)
  exists_on_disk <- folder %in% existing_disease_folders
  path <- file.path(disease_sig_dir, folder, disease_file)
  list(path = path, folder = folder, folder_exists = exists_on_disk)
}

