apply_rigorous_qc <- function(counts) {
  
  message(sprintf("   -> [VERBOSE] Starting QC on matrix with %d genes x %d samples", nrow(counts), ncol(counts)))

  # 1. Sample QC: Exclude samples with > 80% zero gene counts
  #    (Prevents empty/failed libraries from skewing the model)
  zero_prop <- colMeans(counts == 0, na.rm = TRUE)
  keep_samples <- zero_prop <= 0.80
  
  if (sum(!keep_samples) > 0) {
    message(sprintf("   -> [QC] Dropping %d sample(s) with >80%% zero counts.", sum(!keep_samples)))
    counts <- counts[, keep_samples, drop = FALSE]
  } else {
    message("   -> [VERBOSE] No samples failed Zero-Count QC.")
  }
  
  # 2. Gene QC: Exclude lowly expressed genes (CPM < 1 in < 2 samples)
  #    Calculated manually to avoid edgeR dependency
  #    Formula: (count / total_counts_in_sample) * 1,000,000
 # cpm <- t(t(counts) / colSums(counts, na.rm=TRUE)) * 1e6
  
  # Keep genes where at least 2 samples have CPM >= 1
  #keep_genes <- rowSums(cpm >= 1, na.rm = TRUE) >= 2
  
 # message(sprintf("   -> [QC] Filtering low expression genes: Keeping %d / %d genes.", sum(keep_genes), nrow(counts)))
  #counts <- counts[keep_genes, , drop = FALSE]
  
  message(sprintf("   -> [VERBOSE] Final QC Matrix: %d genes x %d samples", nrow(counts), ncol(counts)))
  
  return(counts)
}

run_deseq_single <- function(counts, coldata, gene_id_type = "ensembl", gse_id = NA_character_,
                             out_prefix = "DESeq2_result", alpha = 0.05) {
  
  # Alignment check
  common <- intersect(colnames(counts), coldata$sample)
  message(sprintf("   -> [VERBOSE] Intersection Check: %d samples found in both counts and metadata.", length(common)))

  if (length(common) < 4) stop("Fewer than 4 overlapping samples (need >=2 per group).")
  
  # Subset counts and coldata to match exactly
  counts <- counts[, common, drop = FALSE]
  coldata <- coldata %>% 
    dplyr::filter(sample %in% common) %>% 
    dplyr::arrange(match(sample, colnames(counts)))
  
  # Basic sanity
  if (dplyr::n_distinct(coldata$condition) < 2) stop("Both 'control' and 'case' must be present.")
  
  # --- NEW: Apply Rigorous QC (Sample & Gene Filtering) ---
  counts_qc <- apply_rigorous_qc(counts)
  
  # Re-check samples/genes after QC
  common_post_qc <- intersect(colnames(counts_qc), coldata$sample)
  if(length(common_post_qc) < 4) stop("Too many samples failed QC (< 4 remaining).")
  
  counts_qc <- counts_qc[, common_post_qc, drop = FALSE]
  coldata <- coldata %>% dplyr::filter(sample %in% common_post_qc)
  
  # --- CAPTURE SAMPLE SIZES (Crucial for Meta-Analysis) ---
  n_controls <- sum(coldata$condition == "control")
  n_cases    <- sum(coldata$condition == "case")
  message(sprintf("   -> [VERBOSE] Final Model Configuration: %d Cases vs %d Controls", n_cases, n_controls))
  
  # Run DESeq2
  message("   -> [VERBOSE] initializing DESeqDataSet...")
  dds <- DESeqDataSetFromMatrix(countData = round(counts_qc),
                                colData = as.data.frame(coldata),
                                design = ~ condition)
  
  message("   -> [VERBOSE] Running DESeq() main function...")
  dds <- DESeq(dds, quiet = TRUE)
  
  # Results
  res <- results(dds, alpha = alpha, contrast = c("condition", "case", "control"))
  
  # Shrinkage (apeglm with fallback)
  message("   -> [VERBOSE] Performing LFC Shrinkage...")
  shrink_name <- resultsNames(dds)[grepl("condition_case_vs_control", resultsNames(dds))]
  res_shrunk <- tryCatch({
    suppressPackageStartupMessages({ library(apeglm) })
    lfcShrink(dds, coef = shrink_name, type = "apeglm", quiet = TRUE)
  }, error = function(e) {
    message("   -> apeglm failed/missing, falling back to 'normal'.")
    lfcShrink(dds, coef = shrink_name, type = "normal", quiet = TRUE)
  })
  
  # Merge and Format
  res_merged <- as.data.frame(res) %>%
    rownames_to_column("gene_id") %>%
    as_tibble() %>%
    dplyr::mutate(
      GSE_ID = gse_id, 
      gene_id_type = gene_id_type,
      # Add sample counts for meta-analysis weighting/df calculation
      n_controls = n_controls,
      n_cases = n_cases
    ) %>%
    dplyr::left_join(
      as.data.frame(res_shrunk) %>% 
        rownames_to_column("gene_id") %>% 
        dplyr::select(gene_id, log2FoldChange_shrunk = log2FoldChange, lfcSE_shrunk = lfcSE),
      by = "gene_id"
    ) %>%
    # --- NEW: Bound Standard Errors & Calculate Variance for REML ---
    dplyr::mutate(
      lfcSE_bounded = pmax(0.001, pmin(lfcSE_shrunk, 10)),
      lfcVar_bounded = lfcSE_bounded^2  # Explicit variance for metafor::rma(vi = ...)
    ) %>%
    dplyr::arrange(padj)
  
  # Save
  out_dir <- dirname(out_prefix)
  if (!dir.exists(out_dir)) dir.create(out_dir, recursive = TRUE)
  
  message(sprintf("   -> [VERBOSE] Writing results to: %s_DESeq2_results.csv", basename(out_prefix)))
  write_csv(res_merged, paste0(out_prefix, "_DESeq2_results.csv"))
  
  # Return data for summary
  list(results = res_merged)
}

