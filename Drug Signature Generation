detect_delim <- function(path) {
  first <- readr::read_lines(path, n_max = 1)
  if (length(first) == 0) return("\t")
  counts <- c(tab = str_count(first, "\t"), comma= str_count(first, ","), 
              semi = str_count(first, ";"), pipe = str_count(first, "\\|"))
  dlm <- names(which.max(counts))
  switch(dlm, tab = "\t", comma= ",", semi = ";", pipe = "|", "\t")
}

safe_read_counts <- function(path, gene_col = 1) {
  delim <- detect_delim(path)
  message(sprintf("Reading %s (detected delimiter: '%s')", basename(path), if (delim == "\t") "\\t" else delim))
  
  df <- readr::read_delim(path, delim = delim, guess_max = 100000, show_col_types = FALSE)
  
  # Handle gene column dplyr::selection
  if (is.numeric(gene_col)) gene_col <- names(df)[gene_col]
  
  # Clean and format
  df <- df %>%
    dplyr::mutate(!!gene_col := as.character(.data[[gene_col]])) %>%
    dplyr::distinct(.data[[gene_col]], .keep_all = TRUE) %>%
    dplyr::relocate(dplyr::all_of(gene_col))
  
  df2 <- as.data.frame(df, check.names = FALSE)
  rownames(df2) <- df2[[gene_col]]
  df2[[gene_col]] <- NULL
  
  # Force numeric
  df2[] <- lapply(df2, function(x) suppressWarnings(as.numeric(x)))
  
  # [VERBOSE] Confirm dimensions loaded
  message(sprintf("   -> [VERBOSE] Successfully loaded count matrix: %d genes x %d samples", nrow(df2), ncol(df2)))
  
  return(df2)
}

make_coldata <- function(sample_names, cases, controls, gse_id) {
  all_labs <- c(controls, cases)
  # Intersection check to allow for flexible ordering
  valid_samples <- sample_names[sample_names %in% all_labs]
  
  condition <- factor(ifelse(valid_samples %in% cases, "case",
                             ifelse(valid_samples %in% controls, "control", NA)),
                      levels = c("control", "case"))
  
  # [VERBOSE] Confirm group balance
  n_case <- sum(condition == "case", na.rm = TRUE)
  n_ctrl <- sum(condition == "control", na.rm = TRUE)
  message(sprintf("   -> [VERBOSE] Coldata constructed. Matched Samples: %d (Cases: %d | Controls: %d)", 
                  length(valid_samples), n_case, n_ctrl))
  
  tibble(sample = valid_samples, condition = condition, GSE_ID = gse_id)
}

